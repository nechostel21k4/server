{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "headers": {
                "Content-Security-Policy": "default-src 'none'; script-src 'none'; style-src 'none'; img-src 'self' data: https://res.cloudinary.com; connect-src 'self'; font-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self';",
                "X-Frame-Options": "DENY",
                "X-Content-Type-Options": "nosniff",
                "Referrer-Policy": "strict-origin-when-cross-origin",
                "Permissions-Policy": "camera=(self), geolocation=(self), microphone=(), interest-cohort=()",
                "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
            },
            "dest": "index.js"
        }
    ]
}